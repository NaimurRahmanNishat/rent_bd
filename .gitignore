cat << 'EOF' > .gitignore
# Environment variables
.env
.env.*
**/.env
**/.env.*

# Python / Django
env/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
backend/myproject/staticfiles/
backend/myproject/uploads/
backend/myproject/logs/

# Next.js / Node
frontend/node_modules/
frontend/.next/

# Editor / OS
.vscode/
.idea/
*.log
.DS_Store
EOF